# Copy to engine/.env and fill in. Never commit .env. Keep comments on their own lines.

# --- Telegram (your control panel + client groups) ---
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (message @userinfobot to get it)
TELEGRAM_ADMIN_ID=
# Fallback for alerts if Telegram isn't set up:
# ADMIN_EMAIL=

# --- Microsoft 365 (Teams + email), from your Entra app registration ---
MS_TENANT_ID=
MS_CLIENT_ID=

# --- AI engines used for mention tracking (any left blank are skipped) ---
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional: DataForSEO rank tracking ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- WordPress clients: one pair per client slug (uppercase, dashes become underscores) ---
# WP_HOPE_FCU_USER=
# WP_HOPE_FCU_APP_PASSWORD=
